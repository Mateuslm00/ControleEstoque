# Copie para .env e preencha com valores reais. Nunca commite o .env real.

NODE_ENV=development
PORT=3333

# Postgres
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/estoque_pimentel

# Sessao - gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=troque-por-um-valor-aleatorio-de-64-caracteres-hex
SESSION_ABSOLUTE_TTL_HOURS=8
SESSION_IDLE_TTL_MINUTES=30

# Cookies
# Deixe "localhost" em dev. Em producao SEM dominio proprio (ex: backend no
# onrender.com), tambem deixe "localhost" aqui — o codigo entende esse valor
# como "nao define Domain no cookie", que e o certo quando so existe um host
# de API. So mude para um dominio de verdade se front e back estiverem sob o
# MESMO dominio registravel (ex: api.seudominio.com).
COOKIE_DOMAIN=localhost
# true em producao (HTTPS obrigatorio); false apenas em dev local http
COOKIE_SECURE=false
# "strict" quando front/back estao no mesmo site; "none" quando estao em
# dominios completamente diferentes (ex: *.vercel.app + *.onrender.com) —
# nesse caso COOKIE_SECURE precisa ser true. Ver comentario em src/config/env.ts.
COOKIE_SAMESITE=strict

# CORS - dominios oficiais separados por virgula
CORS_ORIGINS=http://localhost:5173

# Bootstrap do primeiro admin (uso unico - remover apos criar o admin)
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_NAME=

# Email (Resend)
RESEND_API_KEY=
EMAIL_FROM=Controle de Estoque <no-reply@seudominio.com>
EMAIL_MODE=dev
# email fixo do financeiro - nunca aceito via input do usuario
FINANCE_EMAIL=financeiro@seudominio.com

# Rate limit
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
